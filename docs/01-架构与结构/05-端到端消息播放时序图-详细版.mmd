flowchart TD
    classDef backend fill:#e8f1f2,stroke:#2f5d62,color:#163438
    classDef protocol fill:#fff3d6,stroke:#9a6b14,color:#513807
    classDef state fill:#e8edf7,stroke:#3e5f93,color:#1d3154
    classDef timeline fill:#f8e7df,stroke:#9b4d2d,color:#542717
    classDef engine fill:#e9f3df,stroke:#557a35,color:#2e431d
    classDef terminal fill:#f3e6ec,stroke:#8b4865,color:#4b2637
    classDef failure fill:#fde7e3,stroke:#b33a2b,color:#681d14

    subgraph B[后端生成与协议出站]
        U[input.text / input.audio]:::protocol --> TC[TurnCoordinator<br/>确认 turn_id]:::backend
        TC --> AR[AstrBot Persona Runtime<br/>构建系统 / capability / context Prompt]:::backend
        AR --> LLM[主模型一次生成<br/>spoken_reply + effect_calls]:::backend
        LLM --> RC[AG99 result contributor<br/>读取 view.effect_calls]:::backend
        RC --> MI[校验并构建<br/>engine.motion_intent.v4]:::protocol
        LLM --> TTS[AstrBot TTS<br/>生成 Record WAV]:::backend
        LLM --> PT[Plain 可见文本链]:::backend
        TTS --> CO[TurnCoordinator.emit_message_chain]:::backend
        PT --> CO
        MI --> CO
        CO --> ID[归一化逻辑身份<br/>turn_id + message_id]:::protocol
        ID --> OT[output.text<br/>仅可见正文]:::protocol
        ID --> OM[engine.motion_intent<br/>或 performance_curve_hint]:::protocol
        ID --> OA[output.audio<br/>audio_url + caption_text]:::protocol
        CO --> PC[独立小模型异步选择<br/>performance curve]:::backend
        PC -->|音频出站前完成| OM
        PC -->|未完成| PS[记录 skipped<br/>不阻塞音频]:::terminal
        CO --> SF[control.synth_finished]:::protocol
    end

    subgraph F[前端协议接收与事实聚合]
        OT --> PARSE[Inbound strict parser]:::protocol
        OM --> PARSE
        OA --> PARSE
        SF --> PARSE
        PARSE --> SS[TurnPlaybackSessionStore<br/>segments turn_id + message_id]:::state
        SS --> ORCH[TurnPlaybackOrchestrator<br/>只决定何时 release]:::state
        ORCH -->|audio expected 且未到| WAIT3[最多等待 3000ms]:::state
        WAIT3 -->|超时| AF[audio failed<br/>正文可释放 媒体终止]:::failure
        ORCH -->|text + audio, motion 未到| WAIT820[等待动作 820ms]:::state
        ORCH -->|纯文本候选| WAIT260[等待媒体 260ms]:::state
        ORCH --> JOB[PlaybackTimelineSegmentJob<br/>text / audio / motion slots]:::timeline
        AF --> JOB
    end

    subgraph P[统一时间线执行]
        JOB --> TEXT[Text sink<br/>显示可见正文]:::timeline
        JOB --> AUDIO[Audio sink<br/>HTMLAudioElement]:::timeline
        AUDIO --> LIP[Lip-sync sink<br/>同一 AudioElement + WebAudio RMS]:::timeline
        AUDIO --> CLOCK[真实 audio clock<br/>currentTime / duration / rate]:::timeline
        JOB --> MSINK[Motion sink<br/>登记为 required sink]:::timeline
        CLOCK --> PLAYING[audio playing]:::timeline
        PLAYING --> D90[AudioStartMotionBridge<br/>延迟 90ms]:::timeline
        D90 --> MSINK
    end

    subgraph M[动作编译与 Live2D 表现]
        MSINK --> ME[ModelEngine]:::engine
        ME --> VAL[协议 / profile / resource 校验]:::engine
        VAL --> AXIS[九级 axis_levels 确定性采样<br/>强度 + 关系图 + 参数映射]:::engine
        AXIS --> SPEECH[SpeechPoseStage<br/>非周期 speech_gesture_track]:::engine
        SPEECH --> PLAN[engine.parameter_plan.v2]:::engine
        PLAN --> SDK[Live2D WebSDK<br/>逐帧曲线 / dynamics / 写参]:::engine
        LIP --> SDK
        SDK --> MODEL[Live2D Model + Physics]:::engine
    end

    subgraph C[终态与轮次收口]
        TEXT --> SETTLE[SessionStore segment facts]:::terminal
        AUDIO -->|completed / failed / interrupted| SETTLE
        LIP -->|optional terminal| SETTLE
        SDK -->|motion terminal| SETTLE
        SF --> SETTLE
        SETTLE -->|本地 settled 且 synth_finished| PF[control.playback_finished]:::protocol
        PF --> BT[后端 finalize_turn]:::backend
        BT --> TF[control.turn_finished]:::protocol
        TF --> DONE[Session completed / failed]:::terminal
    end

    MODEL -. 下一帧 .-> SDK
