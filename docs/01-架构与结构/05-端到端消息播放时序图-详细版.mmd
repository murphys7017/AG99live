flowchart TD
    classDef backend fill:#e8f1f2,stroke:#2f5d62,color:#163438
    classDef protocol fill:#fff3d6,stroke:#9a6b14,color:#513807
    classDef state fill:#e8edf7,stroke:#3e5f93,color:#1d3154
    classDef timeline fill:#f8e7df,stroke:#9b4d2d,color:#542717
    classDef engine fill:#e9f3df,stroke:#557a35,color:#2e431d
    classDef terminal fill:#f3e6ec,stroke:#8b4865,color:#4b2637
    classDef failure fill:#fde7e3,stroke:#b33a2b,color:#681d14

    subgraph B[后端生成与原子出站]
        U[input.text / input.audio]:::protocol --> TC[TurnCoordinator<br/>确认 turn_id]:::backend
        TC --> AR[Persona Runtime<br/>构建 Prompt 与 effect schema]:::backend
        AR --> LLM[主模型一次生成<br/>spoken_reply + effect_calls]:::backend
        LLM --> RC[result contributor<br/>motion_intent.v4]:::backend
        LLM --> TTS[TTS<br/>Record WAV + caption]:::backend
        LLM --> PT[Plain 可见文本]:::backend
        RC --> BUF[PendingOutputSegment<br/>turn_id + message_id]:::backend
        TTS --> BUF
        PT --> BUF
        BUF --> CHECK[冲突 / 多音频 / motion / curve 校验]:::backend
        CHECK --> SEG[单个 output.segment.v2<br/>完整 tagged slots]:::protocol
        SEG --> SF[随后 control.synth_finished]:::protocol
    end

    subgraph F[前端严格接收与唯一事实源]
        SEG --> PARSE[信封与 slot parser]:::protocol
        PARSE --> PRE[URL 重写 + motion 归一化<br/>全部前置校验]:::protocol
        PRE -->|任何失败| REJECT[拒绝整段<br/>零 Store / Queue 副作用]:::failure
        PRE --> COMMIT[SessionStore.commitOutputSegment]:::state
        COMMIT --> QUEUE[提交后加入 text / audio release queue]:::state
        COMMIT --> ORCH[TurnPlaybackOrchestrator<br/>不等待分片 不设超时器]:::state
        SF --> ASSERT[assertOutputSegmentsResolved]:::state
        ASSERT -->|不完整| REJECT
        ASSERT -->|完整| ORCH
        ORCH --> JOB[一个 PlaybackTimelineSegmentJob]:::timeline
    end

    subgraph P[统一时间线执行]
        JOB --> TEXT[Text sink]:::timeline
        JOB --> AUDIO[Audio sink<br/>HTMLAudioElement]:::timeline
        AUDIO --> LIP[Lip-sync sink<br/>同一 AudioElement + RMS]:::timeline
        AUDIO --> CLOCK[真实 audio clock]:::timeline
        JOB --> MSINK[Required motion sink]:::timeline
        CLOCK --> PLAYING[audio playing]:::timeline
        PLAYING --> D90[AudioStartMotionBridge<br/>约 90ms]:::timeline
        D90 --> MSINK
        JOB -->|audio absent| SYNTH[Synthetic motion-only clock]:::timeline
        JOB -->|audio failed| MFAIL[动作失败 不转 absent]:::failure
    end

    subgraph M[动作编译与 Live2D]
        MSINK --> ME[ModelEngine]:::engine
        SYNTH --> ME
        ME --> VAL[协议 / profile / resource 校验]:::engine
        VAL --> AXIS[九级采样 + relation graph]:::engine
        AXIS --> SPEECH[Speech gesture track]:::engine
        SPEECH --> PLAN[parameter_plan.v2]:::engine
        PLAN --> SDK[Live2D WebSDK<br/>逐帧曲线 / dynamics / 写参]:::engine
        LIP --> SDK
        SDK --> MODEL[Live2D Model + Physics]:::engine
    end

    subgraph C[终态与轮次收口]
        TEXT --> SETTLE[SessionStore segment facts]:::terminal
        AUDIO --> SETTLE
        LIP --> SETTLE
        SDK --> SETTLE
        MFAIL --> SETTLE
        SF --> SETTLE
        SETTLE -->|本地 settled 且 synth_finished| PF[control.playback_finished]:::protocol
        PF --> TF[control.turn_finished]:::protocol
        TF --> DONE[Session completed / failed]:::terminal
    end

    MODEL -. 下一帧 .-> SDK
