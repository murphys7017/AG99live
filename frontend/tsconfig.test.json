{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "outDir": ".test-out",
    "rootDir": ".",
    "types": ["node", "vite/client"],
    "noEmit": false,
    "paths": {
      "@/*": ["src/*"],
      "@framework/*": ["src/live2d/WebSDK/Framework/src/*"]
    }
  },
  "include": ["tests/**/*.ts"]
}
