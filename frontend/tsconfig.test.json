{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "outDir": ".test-out",
    "rootDir": ".",
    "types": ["node", "vite/client"],
    "noEmit": false,
    "paths": {
      "@/*": ["src/*"],
      "@framework/*": ["src/live2d/WebSDK/Framework/src/*"]
    },
    "strictNullChecks": false
  },
  "include": [
    "tests/**/*.ts",
    "tests/**/*.d.ts",
    "src/types/**/*.d.ts",
    "src/live2d/WebSDK/Core/live2dcubismcore.d.ts"
  ]
}
