{
  "name": "ag99live-frontend",
  "private": true,
  "version": "1.0.0",
  "description": "AG99live Live2D desktop client",
  "author": "AG99live",
  "type": "module",
  "main": "./out/main/index.cjs",
  "scripts": {
    "prebuild": "python ../scripts/sync_version.py",
    "build:web": "python ../scripts/sync_version.py && vue-tsc --noEmit -p tsconfig.json && vite build",
    "build:astrbot-page": "python ../scripts/sync_version.py && vue-tsc --noEmit -p tsconfig.json && vite build --config vite.astrbot-page.config.ts",
    "dev": "node scripts/electron-vite-runner.cjs dev",
    "build:spout-sender": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-spout-sender.ps1",
    "start": "node scripts/electron-vite-runner.cjs preview",
    "dev:web": "vite",
    "typecheck": "npm run typecheck:renderer && npm run typecheck:websdk && npm run typecheck:node",
    "typecheck:renderer": "vue-tsc --noEmit -p tsconfig.json",
    "typecheck:websdk": "tsc --noEmit -p tsconfig.websdk.json",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "build": "npm run typecheck && electron-vite build",
    "package:win": "npm run build:spout-sender && npm run build && electron-builder --win --x64",
    "package:win:dir": "npm run build:spout-sender && npm run build && electron-builder --win --x64 --dir",
    "preview": "vite preview"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "uiohook-napi": "^1.5.5",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^37.2.6",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.1.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vue-tsc": "^2.1.8"
  }
}
