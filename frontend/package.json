{
  "name": "ag99live-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "./out/main/index.cjs",
  "scripts": {
    "dev": "node scripts/electron-vite-runner.cjs dev",
    "start": "node scripts/electron-vite-runner.cjs preview",
    "dev:web": "vite",
    "typecheck": "npm run typecheck:renderer && npm run typecheck:websdk && npm run typecheck:node",
    "typecheck:renderer": "vue-tsc --noEmit -p tsconfig.json",
    "typecheck:websdk": "tsc --noEmit -p tsconfig.websdk.json",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "test:desktop-bridge-clone": "tsc -p tsconfig.test.json --outDir .test-out-desktop-bridge-clone && node --experimental-specifier-resolution=node .test-out-desktop-bridge-clone/tests/desktopBridgeClone.test.js",
    "test:push-to-talk-controller": "tsc -p tsconfig.test.json --outDir .test-out-push-to-talk-controller && node --experimental-specifier-resolution=node .test-out-push-to-talk-controller/tests/pushToTalkController.test.js",
    "test:bilibili-live": "tsc -p tsconfig.test.json --outDir .test-out-bilibili-live && node --experimental-specifier-resolution=node .test-out-bilibili-live/tests/bilibiliLive.test.js",
    "test:inbound-protocol": "tsc -p tsconfig.test.json --outDir .test-out-inbound-protocol && node --experimental-specifier-resolution=node .test-out-inbound-protocol/tests/inboundProtocol.test.js",
    "test:inbound-events": "tsc -p tsconfig.test.json --outDir .test-out-inbound-events && node --experimental-specifier-resolution=node .test-out-inbound-events/tests/inboundEvents.test.js",
    "test:model-engine": "tsc -p tsconfig.test.json --outDir .test-out-model-engine && node --experimental-specifier-resolution=node .test-out-model-engine/tests/modelEngineCompiler.test.js",
    "test:playback-timeline": "tsc -p tsconfig.test.json --outDir .test-out-playback-timeline && node --experimental-specifier-resolution=node .test-out-playback-timeline/tests/playbackTimelineEngine.test.js",
    "test:compile": "node scripts/compile-tests.cjs",
    "test": "npm run test:compile && node scripts/run-compiled-tests.cjs",
    "build": "npm run typecheck && electron-vite build",
    "build:web": "vue-tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "uiohook-napi": "^1.5.5",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^37.2.6",
    "electron-vite": "^3.1.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vue-tsc": "^2.1.8"
  }
}
