{
  "name": "ag99live-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "./out/main/index.cjs",
  "scripts": {
    "dev": "node scripts/electron-vite-runner.cjs dev",
    "start": "node scripts/electron-vite-runner.cjs preview",
    "dev:web": "vite",
    "typecheck": "npm run typecheck:renderer && npm run typecheck:node",
    "typecheck:renderer": "vue-tsc --noEmit -p tsconfig.json",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "test:orchestration": "tsc -p tsconfig.test.json --outDir .test-out-orchestration && node --experimental-specifier-resolution=node .test-out-orchestration/tests/turnPlaybackOrchestratorCore.test.js",
    "test:session": "tsc -p tsconfig.test.json --outDir .test-out-session && node --experimental-specifier-resolution=node .test-out-session/tests/turnPlaybackSessionStore.test.js",
    "test:coordinator": "tsc -p tsconfig.test.json --outDir .test-out-coordinator && node --experimental-specifier-resolution=node .test-out-coordinator/tests/playbackCompletionCoordinator.test.js",
    "test:inbound-protocol": "tsc -p tsconfig.test.json --outDir .test-out-inbound-protocol && node --experimental-specifier-resolution=node .test-out-inbound-protocol/tests/inboundProtocol.test.js",
    "test:adapter-connection": "tsc -p tsconfig.test.json --outDir .test-out-adapter-connection && node --experimental-specifier-resolution=node .test-out-adapter-connection/tests/useAdapterConnection.test.js",
    "test": "npm run test:orchestration && npm run test:session && npm run test:coordinator && npm run test:inbound-protocol && npm run test:adapter-connection",
    "build": "npm run typecheck && electron-vite build",
    "build:web": "vue-tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^37.2.6",
    "electron-vite": "^3.1.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vue-tsc": "^2.1.8"
  }
}
