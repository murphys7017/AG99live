{
  "name": "ag99live-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "./out/main/index.cjs",
  "scripts": {
    "dev": "node scripts/electron-vite-runner.cjs dev",
    "start": "node scripts/electron-vite-runner.cjs preview",
    "dev:web": "vite",
    "typecheck": "npm run typecheck:renderer && npm run typecheck:node",
    "typecheck:renderer": "vue-tsc --noEmit -p tsconfig.json",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "test:orchestration": "tsc -p tsconfig.test.json --outDir .test-out-orchestration && node --experimental-specifier-resolution=node .test-out-orchestration/tests/turnPlaybackOrchestratorCore.test.js",
    "test:session": "tsc -p tsconfig.test.json --outDir .test-out-session && node --experimental-specifier-resolution=node .test-out-session/tests/turnPlaybackSessionStore.test.js",
    "test:turn-orchestrator": "tsc -p tsconfig.test.json --outDir .test-out-turn-orchestrator && node --experimental-specifier-resolution=node .test-out-turn-orchestrator/tests/useTurnPlaybackOrchestrator.test.js",
    "test:coordinator": "tsc -p tsconfig.test.json --outDir .test-out-coordinator && node --experimental-specifier-resolution=node .test-out-coordinator/tests/playbackCompletionCoordinator.test.js",
    "test:motion-playback-recorder": "tsc -p tsconfig.test.json --outDir .test-out-motion-playback-recorder && node --experimental-specifier-resolution=node .test-out-motion-playback-recorder/tests/motionPlaybackRecorder.test.js",
    "test:motion-lab-outbound-queue": "tsc -p tsconfig.test.json --outDir .test-out-motion-lab-outbound-queue && node --experimental-specifier-resolution=node .test-out-motion-lab-outbound-queue/tests/motionLabOutboundQueue.test.js",
    "test:preview-motion-player": "tsc -p tsconfig.test.json --outDir .test-out-preview-motion-player && node --experimental-specifier-resolution=node .test-out-preview-motion-player/tests/previewMotionPlayer.test.js",
    "test:desktop-profile-scope": "tsc -p tsconfig.test.json --outDir .test-out-desktop-profile-scope && node --experimental-specifier-resolution=node .test-out-desktop-profile-scope/tests/desktopProfileScope.test.js",
    "test:desktop-bridge-clone": "tsc -p tsconfig.test.json --outDir .test-out-desktop-bridge-clone && node --experimental-specifier-resolution=node .test-out-desktop-bridge-clone/tests/desktopBridgeClone.test.js",
    "test:push-to-talk-controller": "tsc -p tsconfig.test.json --outDir .test-out-push-to-talk-controller && node --experimental-specifier-resolution=node .test-out-push-to-talk-controller/tests/pushToTalkController.test.js",
    "test:bilibili-live": "tsc -p tsconfig.test.json --outDir .test-out-bilibili-live && node --experimental-specifier-resolution=node .test-out-bilibili-live/tests/bilibiliLive.test.js",
    "test:inbound-protocol": "tsc -p tsconfig.test.json --outDir .test-out-inbound-protocol && node --experimental-specifier-resolution=node .test-out-inbound-protocol/tests/inboundProtocol.test.js",
    "test:inbound-events": "tsc -p tsconfig.test.json --outDir .test-out-inbound-events && node --experimental-specifier-resolution=node .test-out-inbound-events/tests/inboundEvents.test.js",
    "test:motion-runtime-scheduler": "tsc -p tsconfig.test.json --outDir .test-out-motion-runtime-scheduler && node --experimental-specifier-resolution=node .test-out-motion-runtime-scheduler/tests/motionRuntimeScheduler.test.js",
    "test:model-engine": "tsc -p tsconfig.test.json --outDir .test-out-model-engine && node --experimental-specifier-resolution=node .test-out-model-engine/tests/modelEngineCompiler.test.js",
    "test:playback-timeline": "tsc -p tsconfig.test.json --outDir .test-out-playback-timeline && node --experimental-specifier-resolution=node .test-out-playback-timeline/tests/playbackTimelineEngine.test.js",
    "test:playback-timeline-audio": "tsc -p tsconfig.test.json --outDir .test-out-playback-timeline-audio && node --experimental-specifier-resolution=node .test-out-playback-timeline-audio/tests/playbackTimelineAudioSink.test.js",
    "test:adapter-audio-runtime": "tsc -p tsconfig.test.json --outDir .test-out-adapter-audio-runtime && node --experimental-specifier-resolution=node .test-out-adapter-audio-runtime/tests/adapterAudioRuntime.test.js",
    "test:adapter-connection": "tsc -p tsconfig.test.json --outDir .test-out-adapter-connection && node --experimental-specifier-resolution=node .test-out-adapter-connection/tests/useAdapterConnection.test.js",
    "test": "npm run test:orchestration && npm run test:session && npm run test:turn-orchestrator && npm run test:coordinator && npm run test:motion-playback-recorder && npm run test:motion-lab-outbound-queue && npm run test:preview-motion-player && npm run test:desktop-profile-scope && npm run test:desktop-bridge-clone && npm run test:push-to-talk-controller && npm run test:bilibili-live && npm run test:inbound-protocol && npm run test:inbound-events && npm run test:motion-runtime-scheduler && npm run test:model-engine && npm run test:playback-timeline && npm run test:playback-timeline-audio && npm run test:adapter-audio-runtime && npm run test:adapter-connection",
    "build": "npm run typecheck && electron-vite build",
    "build:web": "vue-tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "uiohook-napi": "^1.5.5",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^37.2.6",
    "electron-vite": "^3.1.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vue-tsc": "^2.1.8"
  }
}
